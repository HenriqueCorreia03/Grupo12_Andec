# Copiar para .env (na raiz do repositório) e preencher.
# O .env fica fora do Git. Nunca escrever credenciais no código.

# Base de dados da aplicação
DATABASE_URL=postgres://andec:ALTERAR@localhost:5432/andec

# Base de dados de teste (separada; os testes apagam e recarregam os dados)
TEST_DATABASE_URL=postgres://andec:ALTERAR@localhost:5432/andec_test

# Pasta com os CSV originais (relativa à raiz do repositório ou absoluta)
DATA_DIR=./data

# Porta da API (NestJS). O Next.js usa a 3000.
PORT=3001
